# Use 127.0.0.1 for same-computer/reverse-proxy access.
# Use 0.0.0.0 to make GarageLog reachable from your trusted LAN.
GARAGELOG_BIND_ADDRESS=127.0.0.1
GARAGELOG_PORT=6001

# Published image used by compose.ghcr.yaml.
GARAGELOG_IMAGE=ghcr.io/shredder5262/garagelog:0.7.0

# Enables GarageLog's GitHub release update checker.
GARAGELOG_UPDATE_REPOSITORY=Shredder5262/GarageLog

# Set true only when HTTPS is terminated correctly for GarageLog.
GARAGELOG_REQUIRE_HTTPS=false

# Comma-separated trusted reverse-proxy IP addresses. Leave empty for direct access.
GARAGELOG_TRUSTED_PROXIES=
